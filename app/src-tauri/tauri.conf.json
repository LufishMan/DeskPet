{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskPet",
  "version": "0.1.0",
  "identifier": "io.github.lufishman.deskpet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Lufish",
    "copyright": "Copyright © 2026 Lufish. All rights reserved.",
    "shortDescription": "桌面電子寵物",
    "longDescription": "住在桌面角落的像素寵物，靠電腦整體 CPU 用量成長。不連網、不讀取其他程式。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
